<!--
  OR_Gate.circ  — Starter file for Lab 01, Task 1.3
  ====================================================
  This file is a SKELETON. Open it in Logisim-Evolution and build the OR gate.

  Your job:
    1. Open this file  (File → Open)
    2. Build the OR gate circuit:
         - Place two Input Pins  (label: A, B)
         - Place one OR Gate     (Gates library)
         - Place one Output Pin  (label: Y)
         - Wire all components
    3. Test all 4 combinations with the Poke Tool
    4. Take screenshots and save as circuits/OR_Gate.circ
-->
<project version="1.0">
  <lib desc="#Gates" name="0"/>
  <lib desc="#Wiring" name="1"/>
  <circuit name="OR_Gate">
    <!--
      TODO: Build the OR gate circuit in Logisim.
      Logisim will populate this XML when you save.

      Expected components:
        - comp name="OR Gate"  lib="0"   (1 gate)
        - comp name="Pin"      lib="1"   (2 inputs: A, B)
        - comp name="Pin"      lib="1"   (1 output: Y)
        - wire elements
    -->
  </circuit>
</project>
